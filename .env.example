APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses SQLite (no setup needed). On Hostinger, switch to MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=your_db_name
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hostinger shared hosting has no persistent queue worker process running by
# default, so `sync` (runs jobs immediately, inline) is the safe default there.
# Use `database` only if you set up a cron-based `queue:work --stop-when-empty`.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudinary — admin image uploads (Product/Banner/Site Setting logo+favicon).
# Folder used: amarshopbd (matches the old Next.js app). Leave blank locally;
# uploads will just fail with a clear notification until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=amarshopbd

# Google Tag Manager / Meta Pixel — container id itself is stored in
# site_settings (gtm_id, set from the admin GTM/Pixel page). This is only a
# kill switch: set to false to force-disable GTM in an environment (e.g. so
# local/dev never sends production analytics events).
ENABLE_GTM=true

# Steadfast Courier — real API credentials are stored in site_settings via
# the admin Courier settings page, not here. Nothing to set in .env.

# Customer SMS (order confirmed / shipped / delivered), BulkSMSBD-style API.
# Real values are meant to be set from the admin Settings > SMS page
# (API key stored encrypted in site_settings); these are fallbacks.
# SMS_ENABLED defaults to false so nothing is ever sent until you opt in.
SMS_ENABLED=false
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=https://bulksmsbd.net/api/smsapi

# bKash Tokenized Checkout — like Courier, real credentials are meant to be
# set from the admin Payment Settings page (stored encrypted in
# site_settings). These are only fallback defaults for local/sandbox dev
# so BkashService still works before anyone has opened that admin page.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
